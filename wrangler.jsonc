{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "el-paso-traffic-ticket",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "404-page", "html_handling": "auto-trailing-slash", "run_worker_first": true },
  "send_email": [{ "name": "EMAIL" }],
  "ai": { "binding": "AI" },
  "ratelimits": [{ "name": "CHAT_RL", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": true } },
  "workers_dev": true,
  "preview_urls": true,
  "vars": { "LEAD_TO_EMAIL": "david@trafficfirm.org", "LEAD_FROM_EMAIL": "noreply@elpasotrafficticket.com", "LEAD_FROM_NAME": "El Paso Traffic Ticket Firm" }
}
