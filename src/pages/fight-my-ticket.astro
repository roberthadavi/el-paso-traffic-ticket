---
import Base from '../layouts/Base.astro';
import { SITE } from '../data/site';
const title = 'Hire a Traffic Ticket Lawyer Online | El Paso, TX';
const description = "Hire attorney Robert Navar for your El Paso traffic ticket in about two minutes. Flat fee by court: $59 El Paso Municipal, $69 JP and area courts.";
---
<Base prefix="single_page" bodyClass="r-page" title={title} description={description} path="/fight-my-ticket/">
  <main id="main" class="r-svc">
    <section class="r-svc-hero r-checkout-hero">
      <div class="r-wrap">
        <div>
          <ol class="r-crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li><span aria-current="page">Fight My Ticket</span></li></ol>
          <h1>Fight My Ticket — Hire Online</h1>
          <p class="r-lead">Enter your citation and pay the flat attorney fee. Attorney Robert A. Navar files his appearance with the court, and the office confirms by text. Have the citation, your driver's license and your insurance card handy.</p>
          <span class="r-reviewed">Questions first? Call <a href={`tel:${SITE.phone}`} style="color:#fff">{SITE.phone}</a> or text a photo of the ticket to <a href={`sms:${SITE.textPhoneE164}`} style="color:#fff">{SITE.textPhone}</a>.</span>
        </div>
      </div>
    </section>
    <div class="r-wrap r-checkout">
      <div class="r-checkout-form">
        <script is:inline src="https://admin.trafficfirm.org/forms/v2/ttt-embed.js" async data-form="checkout"></script>
        <noscript><p>The checkout form needs JavaScript. Call <a href={`tel:${SITE.phone}`}>{SITE.phone}</a> or text your ticket to <a href={`sms:${SITE.textPhoneE164}`}>{SITE.textPhone}</a> and the office will handle it.</p></noscript>
      </div>
      <p class="ept-form-note">Submitting this form does not create an attorney-client relationship until the office confirms it has your case, and does not stop any court deadline until that confirmation. Court fines and costs are separate from the attorney fee. See the <a href="/terms-of-use/">Terms of Use</a> and <a href="/privacy-policy/">Privacy Policy</a>.</p>
    </div>
  </main>
</Base>
