---
import Base from '../layouts/Base.astro';
import LegacyContent from '../components/LegacyContent.astro';
import html from '../legacy/pages/fight-my-ticket.html?raw';
const title = 'Hire a Traffic Ticket Lawyer Online | El Paso, TX';
const description = "Hire attorney Robert Navar for your El Paso traffic ticket in about two minutes. Flat fee by court: $59 El Paso Municipal, $69 JP and area courts.";
---
<Base prefix="single_page" bodyClass="page-template-default page jet-engine-optimized-dom elementor-default elementor-kit-5 ct-elementor-default-template" title={title} description={description} path="/fight-my-ticket/">
  <LegacyContent html={html} fight />
</Base>
