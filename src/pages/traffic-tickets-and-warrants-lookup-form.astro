---
import Base from '../layouts/Base.astro';
import LegacyContent from '../components/LegacyContent.astro';
import RelatedServices from '../components/RelatedServices.astro';
import html from '../legacy/pages/traffic-tickets-and-warrants-lookup-form.html?raw';
const title = 'Traffic Tickets and Warrants Lookup Form - Elpaso Traffic Ticket';
const description = 'Traffic Ticket and Warrants Lookup Form Traffic Ticket Blog El Paso Warrants Lifted El Paso Municipal Court is renowned for their ability to issue active';
---
<Base prefix="single_page" bodyClass="page-template page-template-elementor_header_footer page jet-engine-optimized-dom elementor-default elementor-template-full-width elementor-kit-5 elementor-page" title={title} description={description} path="/traffic-tickets-and-warrants-lookup-form/">
  <LegacyContent html={html} />
  <RelatedServices slugs={['traffic-warrant-recall', 'omni-hold-removal', 'failure-to-appear']} />
</Base>
