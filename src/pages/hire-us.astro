---
import Base from '../layouts/Base.astro';
import LegacyContent from '../components/LegacyContent.astro';
import RelatedServices from '../components/RelatedServices.astro';
import html from '../legacy/pages/hire-us.html?raw';
const title = 'Hire Us - Elpaso Traffic Ticket';
const description = 'Hire Us';
---
<Base prefix="single_page" bodyClass="page-template page-template-elementor_header_footer page jet-engine-optimized-dom elementor-default elementor-template-full-width elementor-kit-5 elementor-page" title={title} description={description} path="/hire-us/">
  <LegacyContent html={html} fight />
  <RelatedServices slugs={['speeding-ticket', 'no-insurance-ticket', 'traffic-warrant-recall']} />
</Base>
