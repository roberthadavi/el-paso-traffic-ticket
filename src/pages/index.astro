---
import Base from '../layouts/Base.astro';
import LegacyContent from '../components/LegacyContent.astro';
import html from '../legacy/pages/home.html?raw';
const title = 'Traffic Ticket Lawyer in El Paso, Texas';
const description = 'Call (915) 503-1600 Traffic Ticket Lawyer Robert Navar today. I will fight to defend your traffic violation on your behalf without you having to go to court.';
---
<Base prefix="single_page" bodyClass="home page-template-default page jet-engine-optimized-dom elementor-default elementor-kit-5 elementor-page ct-elementor-default-template" title={title} description={description} path="/">
  <LegacyContent html={html} />
</Base>
