---
import Base from '../layouts/Base.astro';
import LegacyContent from '../components/LegacyContent.astro';
import RelatedServices from '../components/RelatedServices.astro';
import html from '../legacy/pages/home.html?raw';
const [top, bottom] = html.split('<!--CARDS:home-->');
const title = 'Traffic Ticket Lawyer El Paso, TX | Robert Navar';
const description = "El Paso traffic ticket attorney Robert Navar handles tickets and warrants in Municipal, JP, Horizon City and Socorro courts. Flat fees from $59; hire online.";
---
<Base prefix="single_page" bodyClass="home page-template-default page jet-engine-optimized-dom elementor-default elementor-kit-5 elementor-page ct-elementor-default-template" title={title} description={description} path="/">
  <LegacyContent html={top} />
  <RelatedServices slugs={['traffic-tickets', 'warrants', 'licenses', 'occupational-drivers-license', 'cdl-ticket', 'courts', 'record-clearing', 'wills-and-estate-planning', 'personal-injury']} title="What we handle for El Paso drivers and families" />
  <LegacyContent html={bottom} />
</Base>
