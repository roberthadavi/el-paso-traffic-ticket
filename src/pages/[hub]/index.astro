---
import Base from '../../layouts/Base.astro';
import ServicePage from '../../components/ServicePage.astro';
import { HUBS, SERVICES, hubOf } from '../../data/services';
import { loadHub, wordCount } from '../../lib/services';
import { SITE } from '../../data/site';
export function getStaticPaths() {
  return HUBS.filter((h) => h.id !== 'personal-injury').map((h) => ({ params: { hub: h.path.replace(/\//g, '') }, props: { id: h.id } }));
}
const { id } = Astro.props;
const H = hubOf(id);
const c = loadHub(id);
if (!c) throw new Error(`Missing hub content: src/content/hubs/${id}.json`);
const faq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: c.faqs.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, ' ').trim() } })) };
const crumbs = { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url + '/' }, { '@type': 'ListItem', position: 2, name: H.name, item: SITE.url + H.path }] };
const list = { '@context': 'https://schema.org', '@type': 'ItemList', name: H.name, itemListElement: SERVICES.filter((s) => s.hub === id && s.slug).map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: SITE.url + s.path })) };
---
<Base title={c.title} description={c.metaDescription} path={H.path} prefix="single_page" bodyClass="page-template-default page jet-engine-optimized-dom elementor-default elementor-kit-5 elementor-page ct-elementor-default-template" jsonLd={[faq, crumbs, list]} pageType="WebPage">
  <main class="site-main hfeed" id="main" tabindex="-1"><div class="ct-container-full" data-content="normal"><article class="page type-page status-publish hentry"><div class="entry-content is-layout-constrained">
    <ServicePage content={c} path={H.path} hub={id} isHub slug={`hub-${id}`} />
  </div></article></div></main>
</Base>
