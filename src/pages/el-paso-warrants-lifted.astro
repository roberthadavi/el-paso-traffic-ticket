---
import Base from '../layouts/Base.astro';
import LegacyContent from '../components/LegacyContent.astro';
import RelatedServices from '../components/RelatedServices.astro';
import html from '../legacy/pages/el-paso-warrants-lifted.html?raw';
const title = 'El Paso Warrants Lifted - Elpaso Traffic Ticket';
const description = 'El Paso Municipal Court is renowned for their ability to issue active arrest warrants almost immediately after an appearance date ...';
---
<Base prefix="single_blog_post" bodyClass="post-template-default single single-post single-format-standard jet-engine-optimized-dom elementor-default elementor-kit-5 ct-elementor-default-template" title={title} description={description} path="/el-paso-warrants-lifted/" pageType="Article">
  <LegacyContent html={html} />
  <RelatedServices slugs={['traffic-warrant-recall', 'failure-to-appear', 'omni-hold-removal']} next={{ slug:  'traffic-warrant-recall', label: "Next step: get the warrant recalled", blurb: "We can usually have an El Paso traffic warrant recalled within 24–48 hours — here is exactly how." }} />
</Base>
