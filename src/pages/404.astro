---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found - Elpaso Traffic Ticket" description="The page you were looking for could not be found." path="/404/" noindex>
  <div class="elementor elementor-1380"><div class="elementor-element e-flex e-con-boxed e-con e-parent"><div class="e-con-inner" style="padding:80px 0;text-align:center">
    <h1 class="elementor-heading-title elementor-size-default">Page not found</h1>
    <p>The page you were looking for doesn't exist or has moved.</p>
    <p><a class="elementor-button elementor-size-sm" href="/"><span class="elementor-button-text">Back to Home</span></a> &nbsp; <a class="elementor-button elementor-size-sm" href="/fight-my-ticket/"><span class="elementor-button-text">Fight My Ticket</span></a></p>
  </div></div></div>
</Base>
