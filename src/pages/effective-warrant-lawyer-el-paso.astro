---
import Base from '../layouts/Base.astro';
import LegacyContent from '../components/LegacyContent.astro';
import RelatedServices from '../components/RelatedServices.astro';
import html from '../legacy/pages/effective-warrant-lawyer-el-paso.html?raw';
const title = 'Effective Warrant Lawyer El Paso, Texas | Fight your ticket';
const description = 'If you have an active warrant and want to get it dismissed. Call me today, as Warrant Lawyer I have dismissed many cases on my clients behalf. Free Consultation';
---
<Base prefix="single_page" bodyClass="page-template-default page jet-engine-optimized-dom elementor-default elementor-kit-5 elementor-page ct-elementor-default-template" title={title} description={description} path="/effective-warrant-lawyer-el-paso/">
  <LegacyContent html={html} />
  <RelatedServices slugs={['traffic-warrant-recall', 'failure-to-appear', 'omni-hold-removal']} next={{ slug:  'warrants', label: "All warrant services", blurb: "Recall, failure to appear and OMNI holds — pick the page that matches your situation." }} />
</Base>
