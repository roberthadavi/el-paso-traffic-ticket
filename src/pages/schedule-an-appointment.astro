---
import Base from '../layouts/Base.astro';
import RelatedServices from '../components/RelatedServices.astro';
import OfficeLocation from '../components/OfficeLocation.astro';
import OfficePhoto from '../components/OfficePhoto.astro';
import { SITE } from '../data/site';
const title = 'Schedule an Appointment | El Paso Traffic Ticket Firm';
const description = "Book a time to talk with attorney Robert Navar's office in El Paso about a ticket, warrant, occupational license, expunction, will or injury claim. Office at 11860 Vista Del Sol Dr.";
---
<Base prefix="single_page" bodyClass="r-page" title={title} description={description} path="/schedule-an-appointment/">
  <main id="main" class="r-svc">
    <section class="r-svc-hero r-checkout-hero">
      <div class="r-wrap">
        <div>
          <ol class="r-crumbs" aria-label="Breadcrumb"><li><a href="/">Home</a></li><li><span aria-current="page">Schedule an Appointment</span></li></ol>
          <h1>Schedule an Appointment in El Paso</h1>
          <p class="r-lead">Most traffic tickets never need a visit — hire online or text a photo of the citation and the office handles the rest. For wills, estate documents, record clearing, occupational licenses and injury claims, set a time to meet at the Vista Del Sol office or talk by phone, in English or Spanish.</p>
          <div class="r-hero-btns">
            <a class="r-btn r-btn-red" href={`tel:${SITE.phone}`}>Call {SITE.phone}</a>
            <a class="r-btn r-btn-white" href="/contact-us/">Request a time by message</a>
          </div>
          <span class="r-reviewed">Traffic ticket or warrant? Skip the appointment: <a href="/fight-my-ticket/" style="color:#fff">hire online</a> or text the ticket to <a href={`sms:${SITE.textPhoneE164}`} style="color:#fff">{SITE.textPhone}</a>.</span>
        </div>
        <OfficePhoto variant="hero" class="r-hero-aside-photo" src="/images/staff/staff-two-couch.jpg" alt="El Paso Traffic Ticket Firm staff in the reception area of the Vista Del Sol office, where appointments are held in El Paso, Texas" eager />
      </div>
    </section>

    <div class="r-wrap r-section r-sched">
      <div class="r-sched-grid">
        <div class="r-side-card"><h3>Before you book</h3><p>Traffic tickets and warrants are handled without an appointment: the attorney files his appearance from a photo of the citation. Use <a href="/fight-my-ticket/">Fight My Ticket</a> or the <a href="/traffic-tickets-and-warrants-lookup-form/">free ticket &amp; warrant check</a>.</p></div>
        <div class="r-side-card"><h3>What to bring</h3><p>Any paperwork from the court, your driver's license, proof of insurance, and for wills or probate the names of the people involved. If you are not sure, bring what you have — the office sorts it out.</p></div>
        <div class="r-side-card"><h3>Phone or in person</h3><p>Consultations for wills, expunctions and occupational licenses can be by phone or at the office. Injury consultations are free. Call <a href={`tel:${SITE.phone}`}>{SITE.phone}</a> to pick a time.</p></div>
      </div>
    </div>
  </main>
  <OfficeLocation />
  <RelatedServices slugs={['wills-and-estate-planning', 'record-clearing', 'traffic-tickets']} />
</Base>
