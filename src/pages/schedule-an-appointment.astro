---
import Base from '../layouts/Base.astro';
import LegacyContent from '../components/LegacyContent.astro';
import RelatedServices from '../components/RelatedServices.astro';
import html from '../legacy/pages/schedule-an-appointment.html?raw';
const title = 'Schedule an Appointment | El Paso Traffic Ticket Firm';
const description = "Book a time to talk with attorney Robert Navar's office in El Paso about a ticket, warrant, occupational license, expunction, will or injury claim.";
---
<Base prefix="single_page" bodyClass="page-template page-template-elementor_header_footer page jet-engine-optimized-dom elementor-default elementor-template-full-width elementor-kit-5 elementor-page" title={title} description={description} path="/schedule-an-appointment/">
  <LegacyContent html={html} />
  <RelatedServices slugs={['wills-and-estate-planning', 'record-clearing', 'traffic-tickets']} />
</Base>
