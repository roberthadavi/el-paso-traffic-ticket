---
import Base from '../layouts/Base.astro';
---
<Base title="Thank You - Elpaso Traffic Ticket" description="We received your request." path="/thank-you/" noindex>
  <div class="elementor elementor-1380"><div class="elementor-element e-flex e-con-boxed e-con e-parent"><div class="e-con-inner" style="padding:80px 0;text-align:center">
    <h1 class="elementor-heading-title elementor-size-default">Thank you!</h1>
    <p>We received your request. Attorney Robert Navar's office will contact you shortly. For anything urgent, call <a href="tel:915-503-1600">915-503-1600</a>.</p>
    <p><a class="elementor-button elementor-size-sm" href="/"><span class="elementor-button-text">Back to Home</span></a></p>
  </div></div></div>
</Base>
