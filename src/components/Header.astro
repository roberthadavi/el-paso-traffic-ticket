---
// Redesigned site header: top bar (address · EN/ES), logo, category mega menus, phone, Text-a-ticket, Fight My Ticket.
// On phones: logo, Text-a-ticket button, EN/ES, burger → drawer with accordion categories.
import { SITE } from '../data/site';
import { HUBS, SERVICES, inHub } from '../data/services';

const groups = [
  { id: 'traffic-tickets', label: 'Traffic Tickets', blurb: 'Every Class C citation in El Paso County — pursuing dismissal, deferred disposition or a driving safety course, with flat fees from $59.', cols: [
    { title: 'Moving violations', slugs: ['speeding-ticket', 'school-zone-speeding', 'red-light-stop-sign-ticket', 'texting-cell-phone-ticket', 'dps-state-trooper-ticket', 'class-c-misdemeanors'] },
    { title: 'Paperwork & license', slugs: ['no-insurance-ticket', 'no-drivers-license-ticket', 'driving-while-license-invalid', 'expired-registration-inspection'] },
    { title: 'Commercial', slugs: ['cdl-ticket', 'trucking-dot-violations'] },
  ] },
  { id: 'warrants', label: 'Warrants', blurb: 'A missed date becomes a warrant, a second charge and a hold on your license. Handled through the court, without an arrest.', cols: [{ title: 'Warrant help', slugs: ['traffic-warrant-recall', 'failure-to-appear', 'omni-hold-removal'] }] },
  { id: 'courts', label: 'Courts', blurb: 'The agency on your citation decides the court. Find yours, its address and our flat fee there.', cols: [
    { title: 'El Paso County courts', slugs: ['el-paso-municipal-court', 'el-paso-county-justice-of-the-peace', 'horizon-city-municipal-court', 'socorro-municipal-court', 'san-elizario-clint-anthony-vinton-municipal-courts'] },
    { title: 'Outcomes', slugs: ['ticket-dismissal', 'deferred-adjudication-defensive-driving'] },
  ] },
  { id: 'licenses', label: 'License', blurb: 'Suspended? First find out why. Then the occupational license, the DWLI charge or the OMNI hold that is in the way.', cols: [{ title: 'Driver\'s license', slugs: ['occupational-drivers-license', 'driving-while-license-invalid', 'omni-hold-removal'] }] },
  { id: 'more', label: 'More Services', blurb: 'Attorney Robert A. Navar also assists El Paso clients with record clearing, estate documents and injury claims.', cols: [
    { title: 'Criminal record clearing', hub: 'record-clearing', slugs: ['expunction', 'order-of-nondisclosure', 'deferred-adjudication-record-cleanup'] },
    { title: 'Wills & estate planning', hub: 'wills-and-estate-planning', slugs: ['wills', 'power-of-attorney-medical-directives', 'probate-small-estate-affidavit'] },
    { title: 'Personal injury', hub: 'personal-injury', slugs: [] },
  ] },
];
const svc = (slug: string) => SERVICES.find((s) => s.slug === slug)!;
const hub = (id: string) => HUBS.find((h) => h.id === id)!;
const hubFor = (g: any) => g.id === 'more' ? null : hub(g.id);
const path = Astro.url.pathname;
---
<header class="r-header" id="r-header">
  <div class="r-topbar">
    <div class="r-wrap r-topbar-in">
      <div class="r-topbar-left"><span>{SITE.address.street}, {SITE.address.city}, {SITE.address.state} {SITE.address.zip}</span><span class="r-topbar-sep">Mon–Fri · Se habla español</span></div>
      <div class="r-lang" role="group" aria-label="Language">
        <span class="r-lang-label">Language</span>
        <button type="button" class="r-lang-btn is-on" data-lang="en" aria-pressed="true">EN</button>
        <button type="button" class="r-lang-btn" data-lang="es" aria-pressed="false">ES</button>
      </div>
    </div>
  </div>
  <div class="r-wrap r-bar">
    <a class="r-logo" href="/" aria-label="El Paso Traffic Ticket Firm — home"><img src="/images/el-logo.png" alt="El Paso Traffic Ticket Firm" width="510" height="322" /></a>
    <nav class="r-nav" aria-label="Main">
      <ul class="r-nav-list">
        {groups.map((g) => { const H = hubFor(g); const active = H ? path.startsWith(H.path) : false; return (
          <li class={`r-nav-item${active ? ' is-active' : ''}`}>
            <button type="button" class="r-nav-link" aria-expanded="false" aria-haspopup="true">{g.label} <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M1 3l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
            <div class="r-mega" role="group" aria-label={g.label} style={`--cols:${g.cols.length}`}>
              <div class="r-mega-in">
                <div class="r-mega-lead">
                  <span class="r-kicker">{H ? H.name : 'More services'}</span>
                  {H ? <a class="r-mega-title" href={H.path}>All {H.short.toLowerCase()} →</a> : <span class="r-mega-title">Beyond traffic tickets</span>}
                  <p>{g.blurb}</p>
                  <a class="r-mega-cta" href="/fight-my-ticket/"><span>Hire online in 2 minutes</span><strong>Fight My Ticket →</strong></a>
                </div>
                {g.cols.map((col: any) => (
                  <div class="r-mega-col">
                    {col.hub ? <a class="r-mega-colhead" href={hub(col.hub).path}>{col.title} →</a> : <span class="r-mega-colhead">{col.title}</span>}
                    {col.slugs.map((s: string) => <a href={svc(s).path}>{svc(s).name}</a>)}
                    {col.hub === 'personal-injury' && <a href={hub('personal-injury').path}>Car accident & injury claims</a>}
                  </div>
                ))}
              </div>
            </div>
          </li>
        ); })}
        <li class="r-nav-item"><a class="r-nav-link" href="/attorney/robert-navar/">Attorney</a></li>
        <li class="r-nav-item"><a class="r-nav-link" href="/faqs/">FAQ</a></li>
      </ul>
    </nav>
    <div class="r-actions">
      <a class="r-phone" href={`tel:${SITE.phone}`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.4 1.8.7 2.7a2 2 0 0 1-.5 2.1L8 9.8a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.7.7a2 2 0 0 1 1.7 2z"/></svg><span>{SITE.phone}</span></a>
      <a class="r-btn r-btn-outline r-text" href={`sms:${SITE.textPhoneE164}`} aria-label={`Text a photo of your ticket to ${SITE.textPhone}`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg><span>Text a ticket</span></a>
      <a class="r-btn r-btn-red r-fight" href="/fight-my-ticket/">Fight My Ticket</a>
      <div class="r-lang r-lang-mobile" role="group" aria-label="Language"><button type="button" class="r-lang-btn is-on" data-lang="en" aria-pressed="true">EN</button><button type="button" class="r-lang-btn" data-lang="es" aria-pressed="false">ES</button></div>
      <button type="button" class="r-burger" id="r-burger" aria-label="Open menu" aria-expanded="false" aria-controls="r-drawer"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg></button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="r-drawer" id="r-drawer" hidden>
    <div class="r-drawer-in">
      {groups.map((g) => { const H = hubFor(g); return (
        <details class="r-acc">
          <summary><span>{g.label}</span><svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M2 5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8"/></svg></summary>
          <div class="r-acc-body">
            {H && <a class="r-acc-all" href={H.path}>All {H.short.toLowerCase()} →</a>}
            {g.cols.map((col: any) => (<>
              {col.hub && <a class="r-acc-all" href={hub(col.hub).path}>{col.title} →</a>}
              {col.slugs.map((s: string) => <a href={svc(s).path}>{svc(s).name}</a>)}
            </>))}
          </div>
        </details>
      ); })}
      <a class="r-drawer-link" href="/attorney/robert-navar/">Attorney Robert A. Navar</a>
      <a class="r-drawer-link" href="/faqs/">FAQ</a>
      <a class="r-drawer-link" href="/blogs/">Blog</a>
      <a class="r-drawer-link" href="/contact-us/">Contact</a>
      <a class="r-drawer-link" href="/traffic-tickets-and-warrants-lookup-form/">Check for tickets &amp; warrants</a>
    </div>
  </div>
</header>
