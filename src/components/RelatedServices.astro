---
// "Related services" cards appended to legacy pages/blog posts so old content links into the core-30 journey.
import { SERVICES, HUBS } from '../data/services';
import ServiceCards from './ServiceCards.astro';
interface Props { slugs: string[]; title?: string; next?: { slug: string; label: string; blurb: string } }
const { slugs, title = 'Related services', next } = Astro.props;
const items = slugs.map((s) => SERVICES.find((x) => x.slug === s) || HUBS.find((h) => h.id === s)).filter(Boolean) as any[];
const nx = next ? (SERVICES.find((x) => x.slug === next.slug) || HUBS.find((h) => h.id === next.slug)) as any : null;
---
<div class="elementor elementor-832 ept-service"><div class="elementor-element e-flex e-con-boxed e-con e-parent ept-cards-wrap" data-e-type="container"><div class="e-con-inner">
  {nx && next && <a class="ept-next" href={nx.path}><span class="ept-next-kicker">{next.label}</span><span class="ept-next-title">{nx.name} →</span><span class="ept-next-blurb">{next.blurb}</span></a>}
  <ServiceCards items={items} title={title} />
</div></div></div>
