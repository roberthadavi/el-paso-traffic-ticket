---
// Free ticket & warrant check — TTT Forms embed (leads land in TTT Admin). The earlier email-based form is kept in LookupFormLegacy.astro.
import { SITE } from '../data/site';
---
<div class="r-embed r-embed-warrant">
  <script is:inline src="https://admin.trafficfirm.org/forms/v2/ttt-embed.js" async data-form="warrant-check"></script>
  <noscript><p>The lookup form needs JavaScript. Call <a href={`tel:${SITE.phone}`}>{SITE.phone}</a> or text a photo of your ticket to <a href={`sms:${SITE.textPhoneE164}`}>{SITE.textPhone}</a>.</p></noscript>
  <p class="ept-form-note">Submitting this form does not create an attorney-client relationship and does not stop any court deadline. See our <a href="/privacy-policy/">Privacy Policy</a>.</p>
</div>
