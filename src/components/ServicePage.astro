---
// Service / hub page body (redesign, Oct 2026): dark hero with breadcrumb + answer-first summary card,
// long-form sections with photo placeholders, hub child cards, FAQ, next-step block, sticky sidebar, author line.
import { SITE } from '../data/site';
import { HUBS, SERVICES, hubOf, type HubId } from '../data/services';
import { resolve, type ServiceContent } from '../lib/services';
import Placeholder from './Placeholder.astro';
import ServiceCards from './ServiceCards.astro';

interface Props { content: ServiceContent; path: string; hub: HubId; isHub?: boolean; price?: string; slug: string; gbp?: string }
const { content: c, path, hub, isHub = false, price, slug, gbp } = Astro.props;
const H = hubOf(hub);
const cta = c.cta || H.cta;
const ctaBtn = cta === 'fight' ? { href: '/fight-my-ticket/', text: 'Fight my ticket' } : cta === 'lookup' ? { href: '/traffic-tickets-and-warrants-lookup-form/', text: 'Check for tickets & warrants' } : { href: '/contact-us/', text: 'Request a free consultation' };
const related = (c.related || []).map(resolve).filter(Boolean) as { name: string; href: string; blurb?: string }[];
const next = c.next ? resolve(c.next.slug) : null;
const siblings = isHub ? SERVICES.filter((s) => s.hub === hub && s.slug) : [];
const crumbs = [{ name: 'Home', href: '/' }, { name: H.name, href: H.path }, ...(isHub ? [] : [{ name: c.h1, href: path }])];
const fmt = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const img = (i: number) => `/images/placeholders/${slug}-${i + 1}.svg`;
const sideLinks = related.length ? related : siblings.slice(0, 4).map((s) => ({ name: s.name, href: s.path }));
---
<div class="r-svc">
  <section class="r-svc-hero">
    <div class="r-wrap">
      <div>
        <ol class="r-crumbs" aria-label="Breadcrumb">{crumbs.map((b, i) => <li>{i < crumbs.length - 1 ? <a href={b.href}>{b.name}</a> : <span aria-current="page">{b.name}</span>}</li>)}</ol>
        <h1>{c.h1}</h1>
        <p class="r-lead">{c.intro}</p>
        <div class="r-hero-btns">
          <a class="r-btn r-btn-red" href={ctaBtn.href}>{ctaBtn.text}</a>
          <a class="r-btn r-btn-white" href={`tel:${SITE.phone}`}>Call {SITE.phone}</a>
        </div>
        <span class="r-reviewed">Written and reviewed by <a href="/attorney/robert-navar/" style="color:#fff">Attorney Robert A. Navar</a>{c.updated && <> · Last reviewed {fmt(c.updated)}</>}</span>
      </div>
      <aside class="r-summary" aria-label="Summary">
        <span class="r-kicker">{c.summaryHeading || (isHub ? 'Start here' : 'What you need to know')}</span>
        <ul>{c.summary.map((s) => <li set:html={s} />)}</ul>
        {price && <p style="margin:0;font-size:14px;color:#555">Flat fee for this court: <b style="color:#f44336;font-size:18px">{price}</b> per ticket — in many traffic cases the attorney appears for you.</p>}
        <a class="r-btn r-btn-outline" href="/fight-my-ticket/">Hire online in 2 minutes →</a>
      </aside>
    </div>
  </section>

  <div class="r-wrap r-svc-body">
    <div class="r-svc-main">
      {c.sections.map((s, i) => (
        <section>
          <h2>{s.heading}</h2>
          {s.paragraphs.map((p) => <Fragment set:html={p.startsWith('<') ? p : `<p>${p}</p>`} />)}
          {s.list && <ul class="r-svc-list">{s.list.map((l) => <li><b>{l.b}</b> <Fragment set:html={l.text} /></li>)}</ul>}
          {s.image && (s.image.src
            ? <figure class="r-svc-photo is-real"><img src={s.image.src} alt={s.image.alt} loading="lazy" decoding="async" width="1800" height="1018" /></figure>
            : <div class="r-svc-photo" role="img" aria-label={s.image.alt}><Placeholder label={s.image.label} /></div>)}
        </section>
      ))}

      {isHub && siblings.length > 0 && (
        <section class="r-svc-children"><ServiceCards items={siblings} title={`${H.name}: every service`} subtitle="Pick the page that matches your situation. Each one explains the law, the court, the fee and what to do next." /></section>
      )}

      {c.faqs?.length > 0 && (
        <section class="r-faq">
          <h2>Frequently asked questions</h2>
          {c.faqs.map((f, i) => (
            <details open={i === 0 ? true : undefined}>
              <summary>{f.q}</summary>
              <div class="r-faq-a"><Fragment set:html={f.a.startsWith('<') ? f.a : `<p>${f.a}</p>`} /></div>
            </details>
          ))}
        </section>
      )}

      {next && c.next && (
        <a class="r-next" href={next.href}><span class="r-kicker">{c.next.label}</span><strong>{next.name} →</strong><span>{c.next.blurb}</span></a>
      )}
    </div>

    <aside class="r-side">
      <div class="r-side-card is-lift">
        <h3>{cta === 'consult' ? 'Talk to the office' : 'Fight this ticket'}</h3>
        <p>{cta === 'consult' ? 'Free initial consultation. English and Spanish.' : 'Flat fee by court. Court fines and costs are separate and set by the court.'}</p>
        {price && <span class="r-side-fee">{price}</span>}
        {!price && cta !== 'consult' && <span class="r-side-fee">from $59</span>}
        <a class="r-btn r-btn-red" href={ctaBtn.href}>{cta === 'consult' ? 'Request a consultation' : 'Hire online'}</a>
        <a class="r-btn r-btn-outline" href={`sms:${SITE.textPhoneE164}`} aria-label={`Text a photo of your ticket to ${SITE.textPhone}`}><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#f44336" stroke-width="2" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>Text a photo of the ticket</a>
      </div>
      {sideLinks.length > 0 && <div class="r-side-card r-side-links"><h3>Related</h3>{sideLinks.map((r) => <a href={r.href}>{r.name} →</a>)}</div>}
      <div class="r-side-author"><i aria-hidden="true"></i><div><strong>Robert A. Navar</strong><span>Attorney · Licensed in Texas 2005</span><a href="/attorney/robert-navar/">About the attorney</a></div></div>
    </aside>
  </div>

  <div class="r-wrap ept-cards-wrap">
    {related.length > 0 && <ServiceCards items={related.map((r) => SERVICES.find((s) => s.path === r.href) || HUBS.find((h) => h.path === r.href))} title="Related services" />}
    <p class="ept-author">Written and reviewed by <a href="/attorney/robert-navar/">Attorney Robert A. Navar</a>, El Paso Traffic Ticket Firm. Licensed in Texas.{c.published && <span class="ept-dates"> Published {fmt(c.published)}{c.updated && c.updated !== c.published && <> · Last reviewed {fmt(c.updated)}</>}.</span>} This page is general information for El Paso County drivers, not legal advice about your specific case, and contacting the office does not by itself create an attorney-client relationship.{c.sources?.length ? <span class="ept-sources"> Sources: {c.sources.map((x, i) => <><a href={x.url} rel="noopener nofollow" target="_blank">{x.name}</a>{i < c.sources!.length - 1 ? ', ' : ''}</>)}.</span> : null} {gbp && <span class="ept-gbp">Google service: {gbp}</span>}</p>
  </div>
</div>
