---
// Chuy — AI chat assistant (Workers AI via /api/chat). Included once in Base.astro.
import { SITE } from '../data/site';
---
<div id="chuy" class="chuy" data-phone={SITE.phone}>
  <button type="button" class="chuy-launch" id="chuy-launch" aria-label="Chat with Chuy" aria-expanded="false" aria-controls="chuy-panel">
    <img src="/images/chuy.svg" alt="" width="56" height="56" />
    <span class="chuy-launch-label">Questions? Ask Chuy</span>
    <span class="chuy-dot" aria-hidden="true"></span>
  </button>

  <section class="chuy-panel" id="chuy-panel" role="dialog" aria-label="Chat with Chuy" hidden>
    <header class="chuy-head">
      <img src="/images/chuy.svg" alt="" width="44" height="44" />
      <div class="chuy-head-text">
        <strong>Chuy</strong>
        <span><i class="chuy-online" aria-hidden="true"></i> El Paso Traffic Ticket Firm · Hablo español</span>
      </div>
      <button type="button" class="chuy-close" id="chuy-close" aria-label="Close chat">&times;</button>
    </header>
    <div class="chuy-log" id="chuy-log" aria-live="polite"></div>
    <div class="chuy-chips" id="chuy-chips">
      <button type="button" data-q="I got a traffic ticket in El Paso. How much to fight it?">Fight a ticket</button>
      <button type="button" data-q="I think I have a warrant. What do I do?">I may have a warrant</button>
      <button type="button" data-q="I missed my court date.">Missed court date</button>
      <button type="button" data-q="Tengo una multa de tráfico. ¿Me pueden ayudar?">En español</button>
    </div>
    <form class="chuy-form" id="chuy-form" autocomplete="off">
      <input type="text" id="chuy-input" name="q" placeholder="Type your question…" maxlength="1000" aria-label="Your message" required />
      <button type="submit" aria-label="Send"><svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><path d="M3 11.5 20 4l-6.5 17-2.6-7.4z" fill="currentColor"/></svg></button>
    </form>
    <p class="chuy-foot">Chuy is an automated assistant, not a lawyer. For anything urgent call <a href={`tel:${SITE.phone}`}>{SITE.phone}</a>.</p>
  </section>
</div>
<script src="../scripts/chuy.ts"></script>
